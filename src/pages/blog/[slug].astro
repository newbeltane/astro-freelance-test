---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { client } from '../../../tina/__generated__/client';
import BlogIsland from '../../components/BlogIsland.jsx';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return posts.map((post, i) => ({
    // Safely generate the URL slug
    params: { slug: post.slug || post.id.replace(/\.md$/, '') },
    props: {
      post,
      prev: posts[i + 1] ?? null,
      next: posts[i - 1] ?? null,
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  prev: CollectionEntry<'blog'> | null;
  next: CollectionEntry<'blog'> | null;
}

const { post, prev, next } = Astro.props;

// Bulletproof check to ensure Tina gets the exact filename with the .md extension
const filename = post.id.endsWith('.md') ? post.id : `${post.id}.md`;

const tinaProps = await client.queries.blog({ relativePath: filename });
const { title, description, pubDate, tags, author } = tinaProps.data.blog;

// Format the date string safely
const dateObj = new Date(pubDate);
const formatted = !isNaN(dateObj.getTime()) 
  ? dateObj.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : '';

// Keep the reading time logic from Astro's raw body
const words = (post.body ?? "").trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.round(words / 200));
---

<BaseLayout title={title} description={description} canonical={`/blog/${post.slug || post.id}/`}>
  <article class="section-sm">
    <div class="container container-narrow">
      <a href="/blog/" class="back">← Back to blog</a>

      <header class="post-head">
        <div class="meta">
          {formatted && <time datetime={dateObj.toISOString()}>{formatted}</time>}
          <span aria-hidden="true">•</span>
          <span>{readingTime} min read</span>
          <span aria-hidden="true">•</span>
          <span>{author}</span>
        </div>
        <h1 class="post-title">{title}</h1>
        <p class="post-desc">{description}</p>
        {tags && tags.length > 0 && (
          <ul class="tags">
            {tags.map((t) => <li>{t}</li>)}
          </ul>
        )}
      </header>

      <!-- Here is the React Island powering the live visual editor -->
      <BlogIsland {...tinaProps} client:only="react" />

      <nav class="post-nav" aria-label="More posts">
        {prev ? (
          <a href={`/blog/${prev.slug || prev.id.replace(/\.md$/, '')}/`} class="card nav-item prev">
            <span class="dir">← Previous</span>
            <span class="nav-title">{prev.data.title}</span>
          </a>
        ) : <span></span>}
        {next && (
          <a href={`/blog/${next.slug || next.id.replace(/\.md$/, '')}/`} class="card nav-item next">
            <span class="dir">Next →</span>
            <span class="nav-title">{next.data.title}</span>
          </a>
        )}
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .back { font-size: var(--fs-sm); font-family: var(--font-mono); }
  .post-head { margin: 1.5rem 0 2.5rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.6rem; font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--text-muted); margin-bottom: 1.1rem; }
  .post-title { font-size: var(--fs-3xl); margin-bottom: 1rem; }
  .post-desc { font-size: var(--fs-lg); color: var(--text-secondary); }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.25rem; }
  .tags li {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    color: var(--accent-cyan);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .nav-item { display: flex; flex-direction: column; gap: 0.35rem; padding: 1.25rem 1.5rem; }
  .nav-item.next { text-align: right; }
  .dir { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--accent-cyan); }
  .nav-title { color: var(--text-primary); font-weight: 600; font-size: var(--fs-sm); }
  @media (max-width: 560px) {
    .post-nav { grid-template-columns: 1fr; }
    .nav-item.next { text-align: left; }
  }
</style>
