---
import TinaPost from '../../components/blog/TinaPost';
import { client } from '../../../tina/__generated__/client';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  posts.sort((a, b) => {
    const dateA = a.data.pubDate ? new Date(a.data.pubDate).valueOf() : 0;
    const dateB = b.data.pubDate ? new Date(b.data.pubDate).valueOf() : 0;
    return dateB - dateA;
  });

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[i + 1] || null,
      next: posts[i - 1] || null,
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  prev: CollectionEntry<'blog'> | null;
  next: CollectionEntry<'blog'> | null;
}

const { post, prev, next } = Astro.props;
const { title, description, pubDate, tags, author } = post.data;

// Tina needs the real filename (with extension), relative to its collection path
const relativePath = post.filePath?.split('/').pop() ?? `${post.id}.md`;
const tinaPost = await client.queries.blog({ relativePath });

const dateObj = new Date(pubDate);
const formatted = !isNaN(dateObj.getTime())
  ? dateObj.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : '';

const words = (post.body ?? '').trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.round(words / 200));
---

<BaseLayout title={title} description={description} canonical={`/blog/${post.id}/`}>
  <article class="section-sm">
    <div class="container container-narrow">
      <a href="/blog/" class="back">← Back to blog</a>

      <header class="post-head">
        <div class="meta">
          {formatted && <time datetime={dateObj.toISOString()}>{formatted}</time>}
          <span aria-hidden="true">•</span>
          <span>{readingTime} min read</span>
          <span aria-hidden="true">•</span>
          <span>{author}</span>
        </div>
        <h1 class="post-title">{title}</h1>
        <p class="post-desc">{description}</p>
        {tags && tags.length > 0 && (
          <ul class="tags">
            {tags.map((t: string) => <li>{t}</li>)}
          </ul>
        )}
      </header>

      <TinaPost
        client:load
        query={tinaPost.query}
        variables={tinaPost.variables}
        data={tinaPost.data}
      />

      <nav class="post-nav" aria-label="More posts">
        {prev ? (
          <a href={`/blog/${prev.id}/`} class="card nav-item prev">
            <span class="dir">← Previous</span>
            <span class="nav-title">{prev.data.title}</span>
          </a>
        ) : <span></span>}
        {next && (
          <a href={`/blog/${next.id}/`} class="card nav-item next">
            <span class="dir">Next →</span>
            <span class="nav-title">{next.data.title}</span>
          </a>
        )}
      </nav>
    </div>
  </article>
</BaseLayout>