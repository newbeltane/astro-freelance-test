---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Blog"
  description="Guides and insights on Astro, web performance, SEO and Cloudflare hosting for small business websites."
>
  <section class="section-sm page-hero">
    <div class="container">
      <span class="eyebrow">Blog</span>
      <h1 class="page-title">Guides &amp; <span class="text-gradient">insights</span></h1>
      <p class="section-intro">Practical advice on building fast, secure, well-ranked websites — from someone who does it every day.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      {posts.length > 0 ? (
        <div class="grid grid-3">
          {posts.map((p) => (
            <BlogCard
              title={p.data.title}
              excerpt={p.data.description}
              date={p.data.pubDate}
              tags={p.data.tags}
              href={`/blog/${p.id}/`}
            />
          ))}
        </div>
      ) : (
        <p>No posts yet — check back soon.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-top: clamp(2.5rem, 6vw, 4rem); }
  .page-title { font-size: var(--fs-3xl); margin: 0.75rem 0 1.25rem; }
</style>
