---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageEditIsland from '../components/tina/PageEditIsland.jsx';
import { client } from '../../tina/__generated__/client';

// Fetch pricing page content from Tina client
const res = await client.queries.page({
  relativePath: 'pricing.md',
});
---

<BaseLayout
  title={res.data.page.title}
  description={res.data.page.description || ""}
>
  <section class="section-sm page-hero">
    <div class="container">
      <div class="section-head max-w-2xl">
        <span class="eyebrow">Investment</span>
      </div>

      <!-- React Island handles title, description, and markdown tiers visually -->
      <div class="card p-8 mb-12">
        <PageEditIsland client:load {...res} />
      </div>

      <div class="cta-banner">
        <div>
          <h2>Have questions about a custom project?</h2>
          <p>Get in touch and I'll help you figure out the best setup for your goals.</p>
        </div>
        <a href="mailto:contact@newbeltanetech.com" class="btn btn-primary">Contact Me <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-top: clamp(2.5rem, 6vw, 4rem); }
  .max-w-2xl { max-width: 48rem; }
  
  .card :global(h1) { font-size: var(--fs-3xl); margin-bottom: 1rem; color: var(--text-primary); }
  .card :global(h2) { font-size: var(--fs-xl); margin-bottom: 1rem; color: var(--text-primary); }
  .card :global(h3) { font-size: var(--fs-lg); margin-top: 2rem; margin-bottom: 0.5rem; color: var(--accent-cyan); }
  .card :global(p) { font-size: var(--fs-base); color: var(--text-secondary); margin-bottom: 0.5rem; line-height: 1.6; }
  .card :global(ul) { margin-bottom: 1.5rem; padding-left: 1.25rem; color: var(--text-secondary); }
  .card :global(li) { margin-bottom: 0.4rem; }
  .card :global(strong) { color: var(--text-primary); }

  .p-8 { padding: clamp(1.5rem, 3vw, 2.5rem); }
  .mb-12 { margin-bottom: 3rem; }

  .cta-banner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 2rem; flex-wrap: wrap;
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-strong);
    background:
      radial-gradient(circle at 15% 20%, rgba(6,182,212,0.12), transparent 55%),
      radial-gradient(circle at 85% 80%, rgba(139,92,246,0.12), transparent 55%),
      var(--bg-card);
  }
  .cta-banner h2 { font-size: var(--fs-xl); margin-bottom: 0.5rem; }
</style>
