---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
---

<BaseLayout
  title="Services"
  description="Web design, web hosting, SEO optimisation and content creation for small businesses, charities and individuals — fast, secure Astro sites on Cloudflare."
>
  <section class="section-sm page-hero">
    <div class="container">
      <span class="eyebrow">Services</span>
      <h1 class="page-title">Everything you need to <span class="text-gradient">launch &amp; grow</span></h1>
      <p class="section-intro">Four core services that cover the full lifecycle of a modern website — from the first design concept to ongoing content that keeps you ranking.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container detailed">
      {services.map((s, i) => (
        <article class="card service-detail" id={s.id}>
          <div class="icon" aria-hidden="true" set:html={s.icon} />
          <div class="body">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h2>{s.title}</h2>
            <p class="lead">{s.description}</p>
            <ul class="points">
              {s.points.map((p) => (
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="cta-banner">
        <div>
          <h2>Not sure which service you need?</h2>
          <p>Tell me your goals and I'll recommend the right mix — with a clear, fixed quote.</p>
        </div>
        <a href="/pricing/" class="btn btn-primary">Get a Quote <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-top: clamp(2.5rem, 6vw, 4rem); }
  .page-title { font-size: var(--fs-3xl); margin: 0.75rem 0 1.25rem; }
  .detailed { display: flex; flex-direction: column; gap: 1.5rem; }
  .service-detail {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    align-items: start;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 64px; height: 64px;
    border-radius: var(--radius);
    background: linear-gradient(135deg, rgba(34,211,238,0.15), rgba(139,92,246,0.15));
    border: 1px solid var(--border-strong);
    color: var(--accent-cyan);
  }
  .icon :global(svg) { width: 30px; height: 30px; }
  .num { font-family: var(--font-mono); font-size: var(--fs-sm); color: var(--accent-cyan); }
  .body h2 { font-size: var(--fs-xl); margin: 0.25rem 0 0.75rem; }
  .lead { font-size: var(--fs-base); margin-bottom: 1.25rem; max-width: 640px; }
  .points { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.7rem; }
  .points li { display: flex; gap: 0.6rem; align-items: flex-start; font-size: var(--fs-sm); }
  .points svg { color: var(--success); flex-shrink: 0; margin-top: 2px; }
  .cta-banner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 2rem; flex-wrap: wrap;
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-strong);
    background:
      radial-gradient(circle at 15% 20%, rgba(6,182,212,0.12), transparent 55%),
      radial-gradient(circle at 85% 80%, rgba(139,92,246,0.12), transparent 55%),
      var(--bg-card);
  }
  .cta-banner h2 { font-size: var(--fs-xl); margin-bottom: 0.5rem; }
  @media (max-width: 640px) {
    .service-detail { grid-template-columns: 1fr; }
    .points { grid-template-columns: 1fr; }
  }
</style>
