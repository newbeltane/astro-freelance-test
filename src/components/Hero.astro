---
// Homepage hero — split layout with a PageSpeed-style visual panel.
---
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="badge"><span class="dot"></span> Available for Projects</span>
      <h1 class="hero-title">
        Websites that are<br />
        <span class="text-gradient">fast, secure &amp; found.</span>
      </h1>
      <p class="hero-sub">
        Freelance web design for small businesses, charities and individuals.
        I build lightning-fast Astro sites that score top marks on PageSpeed and
        SEO — deployed on Cloudflare's global edge.
      </p>
      <div class="hero-cta">
        <a href="/pricing/" class="btn btn-primary">Get a Quote <span aria-hidden="true">→</span></a>
        <a href="/#services" class="btn btn-secondary">View Services</a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="browser">
        <div class="browser-bar">
          <span class="dot-r"></span><span class="dot-y"></span><span class="dot-g"></span>
          <div class="url">https://yourbusiness.co.uk</div>
        </div>
        <div class="browser-body">
          <div class="ps-label">PageSpeed Insights</div>
          <div class="scores">
            <div class="score">
              <svg viewBox="0 0 36 36" class="ring"><circle class="ring-bg" cx="18" cy="18" r="16"/><circle class="ring-fg" cx="18" cy="18" r="16"/></svg>
              <span class="score-num">100</span>
              <span class="score-cap">Performance</span>
            </div>
            <div class="score">
              <svg viewBox="0 0 36 36" class="ring"><circle class="ring-bg" cx="18" cy="18" r="16"/><circle class="ring-fg" cx="18" cy="18" r="16"/></svg>
              <span class="score-num">100</span>
              <span class="score-cap">SEO</span>
            </div>
          </div>
          <div class="metrics">
            <div class="metric"><span>LCP</span><b>0.6 s</b></div>
            <div class="metric"><span>CLS</span><b>0.00</b></div>
            <div class="metric"><span>TBT</span><b>0 ms</b></div>
          </div>
        </div>
      </div>
      <div class="float-chip chip-1">A+ SSL</div>
      <div class="float-chip chip-2">⚡ Edge cached</div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding-block: clamp(3rem, 7vw, 6rem); overflow: hidden; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .hero-title { 
    font-size: clamp(2.2rem, 7vw, 3.8rem); 
    font-weight: 900; 
    line-height: 1.15;
    margin: 1.4rem 0 1.25rem; 
  }
  .hero-sub { font-size: var(--fs-lg); max-width: 520px; }
  
  /* Buttons: Side-by-side, centered, and fully responsive across all screens */
  .hero-cta { 
    display: flex; 
    flex-wrap: nowrap; 
    justify-content: center;
    align-items: center;
    gap: 0.75rem; 
    margin-top: 2rem; 
  }

  .hero-cta .btn {
    flex: 1;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding-inline: 0.5rem;
    font-size: clamp(0.75rem, 2.5vw, 0.95rem);
    white-space: nowrap;
  }

  /* Browser mock */
  .hero-visual { position: relative; }
  .browser {
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow), var(--shadow-glow);
    overflow: hidden;
  }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1rem;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
  }
  .browser-bar span { width: 11px; height: 11px; border-radius: 50%; }
  .dot-r { background: #ff5f57; } .dot-y { background: #febc2e; } .dot-g { background: #28c840; }
  .url {
    margin-left: 0.75rem;
    flex: 1;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    background: var(--bg-primary);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
  }
  .browser-body { padding: clamp(1.25rem, 3vw, 2rem); }
  .ps-label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }
  .scores { display: flex; gap: clamp(1.5rem, 5vw, 3rem); justify-content: center; }
  .score { position: relative; display: grid; place-items: center; text-align: center; }
  .ring { width: 96px; height: 96px; transform: rotate(-90deg); }
  .ring-bg { fill: none; stroke: var(--border); stroke-width: 3; }
  .ring-fg {
    fill: none;
    stroke: var(--success);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 100.5 100.5;
    stroke-dashoffset: 0;
  }
  .score-num {
    position: absolute;
    top: 34px;
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--success);
  }
  .score-cap {
    margin-top: 0.6rem;
    font-size: var(--fs-xs);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .metrics {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .metric { display: flex; flex-direction: column; gap: 0.15rem; font-size: var(--fs-xs); font-family: var(--font-mono); }
  .metric span { color: var(--text-muted); }
  .metric b { color: var(--text-primary); font-size: var(--fs-sm); }

  .float-chip {
    position: absolute;
    padding: 0.5rem 0.9rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-primary);
    box-shadow: var(--shadow);
  }
  .chip-1 { top: -14px; right: 12%; color: var(--accent-cyan); }
  .chip-2 { bottom: -14px; left: 8%; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { max-width: 460px; margin-inline: auto; width: 100%; }
  }
</style>
