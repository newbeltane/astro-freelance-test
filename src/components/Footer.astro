---
import { SITE, NAV_LINKS } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="brand" aria-label={`${SITE.name} home`}>
        <img src="/favicon-96x96.png" alt="Newbeltane Tech Logo" width="26" height="26" />
        <span>{SITE.name}</span>
      </a>
      <p class="footer-tag">{SITE.description}</p>
    </div>

    <nav class="footer-col" aria-label="Footer">
      <h2 class="footer-title">Navigate</h2>
      <ul>
        {NAV_LINKS.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-col">
      <h2 class="footer-title">Get in touch</h2>
      <ul>
        <li><a href="mailto:info@newbeltane.co.uk">info@newbeltane.co.uk</a></li>
        <li><a href="/pricing/">Request a quote</a></li>
        <li><a href="/rss.xml">RSS feed</a></li>
      </ul>
      <div class="socials">
        <a href="https://www.linkedin.com/in/newbeltane/" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {SITE.name}. All rights reserved.</p>
    <p>Built with Astro · Hosted on Cloudflare</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-secondary);
    margin-top: var(--space-section);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 2.5rem;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text-primary);
    font-weight: 800;
    font-size: 1.15rem;
  }
  .footer-tag { margin-top: 1rem; max-width: 340px; font-size: var(--fs-sm); }
  .footer-title {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .footer-col ul { display: flex; flex-direction: column; gap: 0.6rem; }
  .footer-col a { color: var(--text-secondary); font-size: var(--fs-sm); }
  .footer-col a:hover { color: var(--accent-cyan); }
  .socials { display: flex; gap: 0.75rem; margin-top: 1.25rem; }
  .socials a {
    display: grid;
    place-items: center;
    width: 40px; height: 40px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    transition: color var(--transition), border-color var(--transition), transform var(--transition);
  }
  .socials a:hover { color: var(--accent-cyan); border-color: var(--accent-cyan); transform: translateY(-2px); }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  @media (max-width: 720px) {
    .footer-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
