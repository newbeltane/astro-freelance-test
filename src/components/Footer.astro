---
import { SITE, NAV_LINKS, SOCIALS } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="brand" aria-label={`${SITE.name} home`}>
        <svg width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect x="1.5" y="1.5" width="29" height="29" rx="7" stroke="url(#fg)" stroke-width="2" />
          <path d="M8 12.5 11.5 22l3-6 3 6L21 12.5" stroke="url(#fg)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="23.5" cy="9" r="2" fill="#22d3ee" />
          <defs>
            <linearGradient id="fg" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
              <stop stop-color="#22d3ee" /><stop offset="1" stop-color="#8b5cf6" />
            </linearGradient>
          </defs>
        </svg>
        <span>{SITE.name}</span>
      </a>
      <p class="footer-tag">{SITE.description}</p>
    </div>

    <nav class="footer-col" aria-label="Footer">
      <h2 class="footer-title">Navigate</h2>
      <ul>
        {NAV_LINKS.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-col">
      <h2 class="footer-title">Get in touch</h2>
      <ul>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href="/pricing/">Request a quote</a></li>
        <li><a href="/rss.xml">RSS feed</a></li>
      </ul>
      <div class="socials">
        <a href={SOCIALS.github} aria-label="GitHub" target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.76.41-1.27.74-1.56-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.42.36.8 1.08.8 2.18v3.23c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg>
        </a>
        <a href={SOCIALS.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
        </a>
        <a href={SOCIALS.twitter} aria-label="X (Twitter)" target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.24 2h3.31l-7.23 8.26L22.86 22h-6.66l-5.22-6.82L4.99 22H1.68l7.73-8.83L1.14 2h6.83l4.72 6.24L18.24 2Zm-1.16 18h1.83L7.01 3.9H5.05L17.08 20Z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {SITE.name}. All rights reserved.</p>
    <p>Built with Astro · Hosted on Cloudflare</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-secondary);
    margin-top: var(--space-section);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 2.5rem;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text-primary);
    font-weight: 800;
    font-size: 1.15rem;
  }
  .footer-tag { margin-top: 1rem; max-width: 340px; font-size: var(--fs-sm); }
  .footer-title {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .footer-col ul { display: flex; flex-direction: column; gap: 0.6rem; }
  .footer-col a { color: var(--text-secondary); font-size: var(--fs-sm); }
  .footer-col a:hover { color: var(--accent-cyan); }
  .socials { display: flex; gap: 0.75rem; margin-top: 1.25rem; }
  .socials a {
    display: grid;
    place-items: center;
    width: 40px; height: 40px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    transition: color var(--transition), border-color var(--transition), transform var(--transition);
  }
  .socials a:hover { color: var(--accent-cyan); border-color: var(--accent-cyan); transform: translateY(-2px); }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  @media (max-width: 720px) {
    .footer-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
