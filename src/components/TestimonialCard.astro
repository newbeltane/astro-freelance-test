---
interface Props {
  quote: string;
  name: string;
  business: string;
  rating?: number;
}
const { quote, name, business, rating = 5 } = Astro.props;
const initials = name.split(' ').map((n) => n[0]).join('').slice(0, 2).toUpperCase();
---
<figure class="card testimonial">
  <div class="stars" role="img" aria-label={`${rating} out of 5 stars`}>
    {Array.from({ length: 5 }).map((_, i) => (
      <svg width="18" height="18" viewBox="0 0 24 24" fill={i < rating ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2Z"/></svg>
    ))}
  </div>
  <blockquote class="quote">“{quote}”</blockquote>
  <figcaption class="author">
    <span class="avatar" aria-hidden="true">{initials}</span>
    <span class="who">
      <b>{name}</b>
      <small>{business}</small>
    </span>
  </figcaption>
</figure>

<style>
  .testimonial { display: flex; flex-direction: column; gap: 1.1rem; padding: clamp(1.5rem, 3vw, 2rem); height: 100%; }
  .stars { display: flex; gap: 0.15rem; color: var(--star); }
  .quote { font-size: var(--fs-lg); color: var(--text-primary); line-height: 1.6; font-style: normal; }
  .author { display: flex; align-items: center; gap: 0.85rem; margin-top: auto; }
  .avatar {
    display: grid; place-items: center;
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--gradient-accent);
    color: #04121f;
    font-weight: 700;
    font-size: var(--fs-sm);
  }
  .who { display: flex; flex-direction: column; }
  .who b { color: var(--text-primary); font-size: var(--fs-sm); }
  .who small { color: var(--text-muted); font-size: var(--fs-xs); }
</style>
